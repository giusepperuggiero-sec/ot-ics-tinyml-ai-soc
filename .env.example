# Local configuration template for the OT/ICS MQTT & Ollama AI-SOC pipeline.
# Copy this file to `.env` in the repository root and customize values if needed.
# `.env` is ignored by git and automatically loaded by `common/mqtt_config.py`.

# Public testbench broker (unencrypted TCP :1883). For sensitive or private
# environments, run a private Mosquitto broker with TLS (port 8883) and auth.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=ot_ics_sec/pump_01/telemetry
MQTT_TOPIC_ALARMS=ot_ics_sec/pump_01/soc_alarms

OLLAMA_API_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5
OLLAMA_TIMEOUT_S=60

